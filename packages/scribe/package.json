{
  "name": "@rovy/scribe",
  "version": "0.1.0",
  "description": "Rovy integration for Scribe player data",
  "main": "out/init.luau",
  "types": "out/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter @rovy/core build && pnpm --filter rovy-build build && pnpm run typecheck && rovy compile",
    "dev": "rovy compile",
    "verify:vendor": "bash test/studio/verify-vendor.sh",
    "test": "pnpm run verify:vendor && pnpm run build && zune test test/run",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json"
  },
  "files": [
    "out",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "rovy-build": {
    "rbxtscArgs": [
      "--type",
      "package"
    ],
    "generateBlink": false
  },
  "peerDependencies": {
    "@rovy/core": "^0.1.0"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/t": "^3.2.1",
    "@rbxts/types": "^1.0.920",
    "@rovy/core": "workspace:*",
    "roblox-ts": "^3.0.0",
    "rovy-build": "workspace:*",
    "typescript": "^5.9.3"
  },
  "author": "CapedBojji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapedBojji/rovy.git",
    "directory": "packages/scribe"
  },
  "bugs": {
    "url": "https://github.com/CapedBojji/rovy/issues"
  },
  "homepage": "https://capedbojji.github.io/rovy/",
  "keywords": [
    "roblox",
    "roblox-ts",
    "ecs",
    "rovy",
    "scribe",
    "datastore",
    "persistence",
    "player-data"
  ]
}
