{
  "name": "rovy-integration",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$className": "Folder",
            "t": {
              "$className": "Folder",
              "lib": { "$path": "node_modules/@rbxts/t/lib" }
            },
            "better-janitor": {
              "$className": "Folder",
              "src": { "$path": "../../packages/core/node_modules/@rbxts/better-janitor/src" }
            },
            "services": { "$path": "node_modules/@rbxts/services" }
          },
          "@rovy": {
            "$className": "Folder",
            "jecs": { "$path": "node_modules/@rovy/jecs" },
            "core": { "$path": "node_modules/@rovy/core" },
            "datastore": { "$path": "node_modules/@rovy/datastore" },
            "ui": { "$path": "node_modules/@rovy/ui" },
            "imgui": { "$path": "node_modules/@rovy/imgui" },
            "networking": { "$path": "node_modules/@rovy/networking" },
            "world-inspector": { "$path": "node_modules/@rovy/world-inspector" },
            "scribe": { "$path": "node_modules/@rovy/scribe" }
          }
        }
      },
      "RovyIntegration": {
        "$path": "out/shared"
      },
      "Packages": {
        "$className": "Folder",
        "Scribe": { "$path": "../../vendor/scribe/src" }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "RovyVisual": {
          "$path": "out/client"
        }
      }
    }
  }
}
