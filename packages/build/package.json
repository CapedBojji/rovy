{
  "name": "rovy-build",
  "version": "0.1.0",
  "description": "Build manager and project orchestrator for Rovy games",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rovy": "bin/rovy-build.js",
    "rovy-build": "bin/rovy-build.js"
  },
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "pnpm --filter rovy-transformer build && tsc -p tsconfig.json",
    "test": "pnpm run build && node test/run.js"
  },
  "dependencies": {
    "typescript": "5.5.3"
  },
  "peerDependencies": {
    "rovy-transformer": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.31",
    "rovy-transformer": "workspace:*"
  },
  "author": "CapedBojji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapedBojji/rovy.git",
    "directory": "packages/build"
  },
  "bugs": {
    "url": "https://github.com/CapedBojji/rovy/issues"
  },
  "homepage": "https://capedbojji.github.io/rovy/",
  "keywords": [
    "roblox",
    "roblox-ts",
    "ecs",
    "rovy",
    "cli",
    "build-tool",
    "rojo",
    "blink"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  }
}
