return function(TS, t)
	local Pool = TS.loadPath("out/pool").WorkerPool
	local Kernel = TS.loadPath("out/kernel")
	local task = zune.task
	local function definition(id, kernel, serialBelow)
		local execute = kernel or function(input, output) for i = 1, input.count do output[i] = input.columns[1][i] * 2 end end
		return {__id = id or "double", __inputCount = 1, serialBelow = serialBelow,
			run = function(_, input, output, state) return execute(input, output, state) end}
	end
	local function fixture(options)
		options = options or {}
		local transport = { pending = {}, ready = {} }
		function transport:start(jobs, count, ready, complete)
			self.jobs, self.complete, self.onReady = jobs, complete, ready
			if not options.delayStartup then for i = 1, count do ready(i, options.startupError) end end
		end
		function transport:dispatch(worker, generation, ticket, id, first, count, columns)
			table.insert(self.pending, {worker, generation, ticket, first, count, id, Kernel.snapshot(columns)})
		end
		function transport:destroy() self.destroyed = true end
		function transport:finish(index, forcedError)
			local item = table.remove(self.pending, index or 1)
			assert(item, "no pending chunk")
			local output = {}
			local ok, err = Kernel.run(self.jobs[item[6]], nil, {count = item[5], columns = item[7]}, output)
			self.complete(item[1], item[2], item[3], item[4], item[5], ok and not forcedError, forcedError or (ok and output or err))
			return item
		end
		function transport:finishAll() while #self.pending > 0 do self:finish() end end
		local pool = Pool.new({ jobs = options.jobs or {definition()}, workers = options.workers or 2,
			chunkSize = options.chunkSize or 2, maxBatches = options.maxBatches or 8, maxRows = options.maxRows or 32,
			transport = transport, assertCanWait = options.assertCanWait })
		return pool, transport
	end
	local function submit(pool, values, id)
		return pool:tryBatch(id or "double", function(batch)
			for index, value in values do batch:push(index, value) end
		end)
	end
	local function drain(pool, id, alive)
		local values = {}
		pool:drain(id or "double", function(entity, value) table.insert(values, {entity, value}) end, alive)
		return values
	end

	t.describe("bounded parallel pool", function()
		t.it("chunks remainders and restores row order after reordered replies", function()
			local pool, transport = fixture()
			submit(pool, {10,20,30,40,50})
			transport:finish(2)
			t.expect(#drain(pool)).toBe(0)
			transport:finishAll()
			local values = drain(pool)
			t.expect(#values).toBe(5)
			for i = 1, 5 do t.expect(values[i][2]).toBe(i * 20) end
			t.expect(pool:stats().retainedBatches).toBe(0)
		end)
		t.it("holds later batches behind unfinished earlier batches", function()
			local pool, transport = fixture()
			pool:tryBatch("double", function(batch) batch:push(10, 1) end)
			pool:tryBatch("double", function(batch) batch:push(20, 2) end)
			transport:finish(2)
			t.expect(#drain(pool)).toBe(0)
			transport:finishAll()
			local result = drain(pool)
			t.expect(result[1][1]).toBe(10)
			t.expect(result[2][1]).toBe(20)
		end)
		t.it("rejects exhaustion without invoking fill and reuses slots", function()
			local pool, transport = fixture({maxBatches = 1})
			submit(pool, {1,2,3})
			local called = false
			t.expect(pool:tryBatch("double", function() called = true end)).toBe(nil)
			t.expect(called).toBe(false)
			transport:finishAll(); drain(pool)
			t.expect(submit(pool, {4})).never.toBe(nil)
			transport:finishAll()
			local result = drain(pool)
			t.expect(#result).toBe(1)
			t.expect(result[1][2]).toBe(8)
		end)
		t.it("snapshots caller tables before queued work runs", function()
			local pool, transport = fixture({jobs={definition("value", function(input, output) output[1] = input.columns[1][1].x end)}})
			local value = {x = 7}
			pool:tryBatch("value", function(batch) batch:push(1, value) end)
			value.x = 99
			transport:finishAll()
			t.expect(drain(pool, "value")[1][2]).toBe(7)
		end)
		t.it("clears failed partial results and releases failure storage", function()
			local pool, transport = fixture()
			submit(pool, {1,2,3})
			transport:finish()
			transport:finish(1, "boom")
			t.expect(#drain(pool)).toBe(0)
			local failure
			pool:drainFailures("double", function(value) failure = value end)
			t.expect(failure.message).toBe("boom")
			t.expect(pool:stats().retainedBatches).toBe(0)
		end)
		t.it("quarantines cancelled workers and rejects duplicate stale replies", function()
			local pool, transport = fixture({workers = 1, maxBatches = 1})
			local ticket = submit(pool, {1,2,3})
			t.expect(pool:cancel(ticket)).toBe(true)
			pool:drainFailures("double", function() end)
			submit(pool, {7})
			t.expect(#transport.pending).toBe(1)
			local old = transport:finish()
			transport.complete(old[1], old[2], old[3], old[4], old[5], true, {99,99})
			t.expect(pool:stats().busyWorkers).toBe(1)
			transport:finishAll()
			t.expect(drain(pool)[1][2]).toBe(14)
		end)
		t.it("rejects dead generations and superseded entities", function()
			local pool, transport = fixture()
			submit(pool, {1,2})
			submit(pool, {8})
			transport:finishAll()
			local result = drain(pool, nil, function(entity) return entity == 1 end)
			t.expect(#result).toBe(1)
			t.expect(result[1][2]).toBe(16)
			t.expect(pool:stats().staleRows).toBe(2)
		end)
		t.it("releases successful and failed batches after callback errors", function()
			local pool, transport = fixture({maxBatches = 1})
			submit(pool, {1}); transport:finishAll()
			t.expect(pcall(function() pool:drain("double", function() error("apply") end) end)).toBe(false)
			t.expect(pool:stats().retainedBatches).toBe(0)
			local ticket = submit(pool, {2}); pool:cancel(ticket)
			t.expect(pcall(function() pool:drainFailures("double", function() error("failure callback") end) end)).toBe(false)
			t.expect(pool:stats().retainedBatches).toBe(0)
		end)
		t.it("handles empty batches and limits without leaking", function()
			local pool = fixture({maxRows = 1})
			local empty = submit(pool, {})
			t.expect(pool:wait(empty, 0).ok).toBe(true)
			t.expect(#drain(pool)).toBe(0)
			t.expect(pool:stats().retainedBatches).toBe(0)
			t.expect(pcall(function() submit(pool, {1,2}) end)).toBe(false)
			t.expect(pool:stats().retainedBatches).toBe(0)
		end)
		t.it("serial fallback matches output and never dispatches", function()
			local pool, transport = fixture({jobs={definition("double", nil, 10)}})
			local ticket = submit(pool, {3,5})
			t.expect(pool:wait(ticket, 0).ok).toBe(true)
			t.expect(#transport.pending).toBe(0)
			t.expect(drain(pool)[2][2]).toBe(10)
		end)
		t.it("rejects yielding and incomplete kernels", function()
			for _, run in {function() coroutine.yield() end, function() end, function() error("kernel error") end} do
				local pool, transport = fixture({jobs={definition("double", run)}})
				submit(pool, {1}); transport:finishAll()
				t.expect(#drain(pool)).toBe(0)
				local failures = 0
				pool:drainFailures("double", function() failures += 1 end)
				t.expect(failures).toBe(1)
			end
		end)
		t.it("returns startup failures and rejects new batches", function()
			local pool = fixture({startupError = "setup failed"})
			t.expect(pool:ready(0)).toBe(false)
			t.expect(submit(pool, {1})).toBe(nil)
		end)
		t.it("timeout cancels captured batches and wakes event-driven waits", function()
			local pool, transport = fixture()
			local ticket = submit(pool, {1,2,3})
			t.expect(pool:wait(ticket, 0).ok).toBe(false)
			local reason
			pool:drainFailures("double", function(failure) reason = failure.reason end)
			t.expect(reason).toBe("timeout")
			transport:finishAll()
			local second = submit(pool, {3})
			task.delay(0.01, function() transport:finishAll() end)
			t.expect(pool:wait(second, 1).ok).toBe(true)
		end)
		t.it("destroy wakes waiters and ignores late completions", function()
			local pool, transport = fixture()
			local ticket = submit(pool, {1})
			task.delay(0.01, function() pool:destroy() end)
			t.expect(pool:wait(ticket, 1).ok).toBe(false)
			transport:finishAll()
			pool:destroy()
			t.expect(pool:stats().retainedBatches).toBe(0)
		end)
		t.it("barrier captures current submissions only", function()
			local pool, transport = fixture({workers = 1})
			submit(pool, {1})
			task.delay(0.01, function()
				pool:tryBatch("double", function(batch) batch:push(2, 10) end)
				transport:finish()
			end)
			t.expect(pool:barrier({"double"}, 1).ok).toBe(true)
			t.expect(#transport.pending).toBe(1)
			transport:finishAll(); drain(pool)
		end)
		t.it("enforces integration wait guard even for completed work", function()
			local pool = fixture({assertCanWait = function() error("inside system") end})
			t.expect(pcall(function() pool:barrier({}, 0) end)).toBe(false)
			t.expect(pcall(function() pool:ready(0) end)).toBe(false)
		end)
		t.it("low-level submit and poll have explicit output lifetime", function()
			local pool, transport = fixture()
			local ticket = pool:submit("double", {columns={{4,6}}, count=2})
			t.expect(pool:poll(ticket, function() end)).toBe(false)
			transport:finishAll()
			local sum = 0
			t.expect(pool:poll(ticket, function(result) for _, value in result.output do sum += value end end)).toBe(true)
			t.expect(sum).toBe(20)
			t.expect(pool:poll(ticket, function() end)).toBe(false)
		end)
		t.it("pool tickets cannot cancel another pool's work", function()
			local a = fixture(); local b = fixture()
			local first = submit(a, {1}); submit(b, {1})
			t.expect(b:cancel(first)).toBe(false)
			a:destroy(); b:destroy()
		end)
		t.it("invalid wait arguments never pin pool slots", function()
			local pool, transport = fixture({maxBatches=1})
			local ticket = submit(pool, {1})
			t.expect(pcall(function() pool:wait(ticket, -1) end)).toBe(false)
			t.expect(pcall(function() pool:barrier({"double", "unknown"}, 1) end)).toBe(false)
			transport:finishAll(); drain(pool)
			t.expect(submit(pool, {2})).never.toBe(nil)
			pool:destroy()
		end)
		t.it("rejects submissions until every worker is ready", function()
			local pool, transport = fixture({delayStartup=true})
			t.expect(submit(pool, {1})).toBe(nil)
			transport.onReady(1, nil)
			t.expect(submit(pool, {1})).toBe(nil)
			transport.onReady(2, "setup failed")
			t.expect(pool:ready(0)).toBe(false)
			t.expect(pool:stats().retainedBatches).toBe(0)
		end)
		t.it("rejects yielding fill and drain callbacks without leaking", function()
			local pool, transport = fixture({maxBatches=1})
			t.expect(pcall(function() pool:tryBatch("double", function() coroutine.yield() end) end)).toBe(false)
			t.expect(pool:stats().retainedBatches).toBe(0)
			submit(pool, {1}); transport:finishAll()
			t.expect(pcall(function() pool:drain("double", function() coroutine.yield() end) end)).toBe(false)
			t.expect(pool:stats().retainedBatches).toBe(0)
		end)
		t.it("serial setup cannot suspend an ECS submission", function()
			local job = definition("double", nil, 10)
			job.setup = function() coroutine.yield() end
			local pool = fixture({jobs={job}})
			local ticket = submit(pool, {1})
			t.expect(pool:wait(ticket, 0).ok).toBe(false)
			local reason
			pool:drainFailures("double", function(failure) reason = failure.reason end)
			t.expect(reason).toBe("setup")
			t.expect(pool:stats().retainedBatches).toBe(0)
		end)
		t.it("destroying during fill cannot accept work after teardown", function()
			local pool, transport = fixture()
			t.expect(pcall(function()
				pool:tryBatch("double", function(batch)
					batch:push(1, 2)
					pool:destroy()
				end)
			end)).toBe(false)
			t.expect(pool:stats().retainedBatches).toBe(0)
			t.expect(pool:stats().submitted).toBe(0)
			t.expect(#transport.pending).toBe(0)
		end)
	end)
end
