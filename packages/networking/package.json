{
  "name": "@rovy/networking",
  "version": "0.0.0",
  "description": "Networking package for Rovy net events over generated transports",
  "main": "out/init.luau",
  "types": "out/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter @rovy/core build && pnpm --filter rovy-build build && rovy compile",
    "dev": "rovy compile",
    "test": "npm run build && zune test test/run"
  },
  "files": [
    "out",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "rovy-build": {
    "rbxtscArgs": [
      "--type",
      "package"
    ],
    "generateBlink": false
  },
  "peerDependencies": {
    "@rovy/core": "0.0.0"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.920",
    "@rovy/core": "workspace:*",
    "rovy-build": "workspace:*",
    "typescript": "^5.9.3",
    "roblox-ts": "^3.0.0"
  }
}
