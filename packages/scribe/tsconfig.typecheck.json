{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "../../out/scribe-typecheck",
    "incremental": true,
    "tsBuildInfoFile": "../../out/scribe-typecheck/tsconfig.tsbuildinfo",
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@rovy/scribe": ["src/index.ts"]
    }
  },
  "include": ["src", "__typecheck.ts", "docs-examples"]
}
